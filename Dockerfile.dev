# Use an official Node.js runtime as a parent image (pinned version)
FROM node:20-alpine

# Set the working directory in the container
WORKDIR /app

# Install dependencies (cached layer)
COPY package.json .
RUN npm install

# Copy the rest of the application code to the container
COPY . .

# Run as non-root user for security
# Note: 'node' user is built into the official Node.js Alpine image
USER node

# Start the Vite dev server
CMD ["npm", "run", "dev"]